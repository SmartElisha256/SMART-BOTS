{
  "name": "elisha-sports-bot",
  "version": "1.0.0",
  "description": "WhatsApp football information bot for ELISHA SPORTS BOT",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prod": "NODE_ENV=production node src/server.js",
    "worker": "node src/jobs/worker.js",
    "dev:all": "node --watch src/server.js & node src/jobs/worker.js",
    "test": "node --test --test-timeout=20000",
    "test:ci": "node --test --test-timeout=20000 --test-reporter=spec",
    "test:commands": "node --test tests/commands.test.js",
    "test:sports": "node --test tests/sports.test.js",
    "test:messaging": "node --test tests/messaging.test.js",
    "validate:messaging": "node src/bin/validate-messaging.js",
    "validate:env": "node -e \"import { validateEnvironment } from './src/config/env.js'; console.log(JSON.stringify(validateEnvironment(), null, 2));\""
  },
  "keywords": [
    "whatsapp",
    "sports",
    "bot",
    "express",
    "postgres",
    "redis",
    "bullmq"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bullmq": "^5.10.0",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "ioredis": "^5.6.1",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "rate-limiter-flexible": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
