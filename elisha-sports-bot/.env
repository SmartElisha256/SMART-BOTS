NODE_ENV=development
PORT=3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://bot_user:change_me@localhost:5432/elisha_sports

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Messaging Provider: mock, callmebot, or whatsapp-cloud
MESSAGING_PROVIDER=mock

# Sports Data Provider: mock or external
SPORTS_PROVIDER=mock

# CallMeBot Configuration (for MESSAGING_PROVIDER=callmebot)
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
CALLMEBOT_ENDPOINT=https://api.callmebot.com/whatsapp.php

# WhatsApp Cloud API Configuration (for MESSAGING_PROVIDER=whatsapp-cloud)
WHATSAPP_CLOUD_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Job Configuration
JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY=5

# Cache Configuration (in seconds)
CACHE_TTL_FIXTURES=600
CACHE_TTL_TABLE=900
CACHE_TTL_FORM=1800

# Rate Limiting Configuration
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60

# Logging
LOG_LEVEL=info
