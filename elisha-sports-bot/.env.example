NODE_ENV=development
PORT=3000

# Docker Compose service names are used inside containers.
# For running Node directly on your computer, change postgres/redis to localhost.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/elisha_sports_bot
REDIS_URL=redis://redis:6379

# WhatsApp Cloud API configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me-with-a-long-random-value
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_API_VERSION=v19.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# Messaging provider: mock, callmebot, or whatsapp-cloud
MESSAGING_PROVIDER=mock

# CallMeBot is a limited outbound adapter, not a public inbound bot webhook.
CALLMEBOT_API_KEY=replace-me
CALLMEBOT_PHONE=replace-me
CALLMEBOT_ENDPOINT=https://api.callmebot.com/whatsapp.php

# Sports provider: mock or api-football
SPORTS_DATA_PROVIDER=mock
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_KEY=
SPORTS_API_LEAGUE_ID=39
SPORTS_API_SEASON=2026

# Optional AI summaries. Never commit a real API key or .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

CACHE_TTL_FIXTURES=600
CACHE_TTL_TABLE=900
CACHE_TTL_FORM=1800

JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY=5

# Daily football-information quotas. Reset at midnight Africa/Kampala time.
FREE_DAILY_REQUEST_LIMIT=20
PREMIUM_DAILY_REQUEST_LIMIT=200

# Manual Airtel Money merchant payment. Configure privately in the deployment environment.
PREMIUM_PRICE_UGX=5000
MOMO_NETWORK=Airtel Money
MOMO_MERCHANT_CODE=SET_YOUR_MERCHANT_CODE
MOMO_MERCHANT_NAME=SMART ELISHA 256
# Comma-separated administrator phone numbers in international digits, without +.
# Example only: PAYMENT_ADMIN_PHONES=256700000000
PAYMENT_ADMIN_PHONES=

# General HTTP rate limit (separate from daily quotas).
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60
LOG_LEVEL=info
