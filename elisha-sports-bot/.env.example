NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/elisha_sports_bot
REDIS_URL=redis://redis:6379

# --- Messaging ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me-with-a-long-random-value
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_API_VERSION=v19.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
# mock (local) or whatsapp-cloud (production)
MESSAGING_PROVIDER=mock

# --- FREE football data (recommended start: football-data.org) ---
# Register free token: https://www.football-data.org/client/register
# SPORTS_DATA_PROVIDER: mock | football-data | api-football
# (api-football name is legacy; provider talks to football-data.org v4)
SPORTS_DATA_PROVIDER=football-data
SPORTS_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=
SPORTS_API_KEY=
SPORTS_API_LEAGUE_ID=PL
SPORTS_API_SEASON=2025

# Cache TTLs (seconds) — longer cache = fewer free API calls
CACHE_TTL_FIXTURES=600
CACHE_TTL_TABLE=900
CACHE_TTL_FORM=1800

# --- FREE / optional AI (OpenRouter recommended for $0) ---
# Leave OPENAI_API_KEY empty to run without AI chat; ANALYZE still works via local ML.
# OpenRouter: https://openrouter.ai → create key → use a :free model id from their models page
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_STYLE=auto
OPENAI_MODEL=openrouter/free
OPENAI_TIMEOUT_MS=15000

# ML predict HTTP protection
FOOTBALL_ML_API_KEY=
FOOTBALL_ML_TIMEOUT_MS=20000

ADMIN_API_KEY=replace-me-with-a-long-random-admin-key

JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY=5
FREE_DAILY_REQUEST_LIMIT=20
PREMIUM_DAILY_REQUEST_LIMIT=200
PREMIUM_MONTHLY_REQUEST_LIMIT=300

PREMIUM_PRICE_DAY_UGX=1000
PREMIUM_PRICE_WEEK_UGX=5000
PREMIUM_PRICE_MONTH_UGX=15000
PREMIUM_PRICE_UGX=5000
MOMO_NETWORK=Airtel Money
MOMO_MERCHANT_CODE=SET_YOUR_MERCHANT_CODE
MOMO_MERCHANT_NAME=
PAYMENT_ADMIN_PHONES=

RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60
LOG_LEVEL=info
