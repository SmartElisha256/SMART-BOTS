NODE_ENV=development
PORT=3000

# Required for PostgreSQL runtime storage
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/elisha_sports_bot

# Required for Redis background jobs and rate limiting
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API configuration (optional)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_API_VERSION=v19.0
WHATSAPP_API_BASE_URL=https://graph.instagram.com

# CallMeBot configuration for outbound WhatsApp messages
# See: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=replace-me
CALLMEBOT_PHONE=replace-me
CALLMEBOT_ENDPOINT=https://api.callmebot.com/whatsapp.php

# Messaging provider: 'mock' or 'callmebot'
MESSAGING_PROVIDER=mock

# Optional sports data source (leave unset to use mock provider)
SPORTS_API_BASE_URL=
SPORTS_API_KEY=

# Cache configuration (in seconds)
CACHE_TTL_FIXTURES=600
CACHE_TTL_TABLE=900
CACHE_TTL_FORM=1800

# Job configuration
JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY=5

# Rate limiting
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60

# Logging
LOG_LEVEL=info
