NODE_ENV=development
PORT=3000

# Required for PostgreSQL runtime storage
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/elisha_sports_bot

# Required for Redis background jobs and rate limiting
REDIS_URL=redis://localhost:6379

# Required for WhatsApp Cloud API webhook verification/send functionality
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# Optional messaging provider settings
CALLMEBOT_API_URL=https://api.callmebot.com/whatsapp.php
CALLMEBOT_TOKEN=replace-me

# Optional sports data source (leave unset to use mock provider)
SPORTS_API_BASE_URL=
SPORTS_API_KEY=

# Logging
LOG_LEVEL=info
