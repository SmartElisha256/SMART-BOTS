modules = ["nodejs-20", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["redis"]

[agent]
expertMode = true

[userenv]

[userenv.development]
MESSAGING_PROVIDER = "mock"
NODE_ENV = "development"
PORT = "5000"
REDIS_URL = "redis://127.0.0.1:6379"
SPORTS_DATA_PROVIDER = "mock"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Football bot"

[[workflows.workflow]]
name = "Football bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
